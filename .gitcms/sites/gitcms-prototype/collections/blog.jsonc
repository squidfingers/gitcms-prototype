{
  "git_path": "/content/blog/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": false
    },
    {
      "name": "date",
      "type": "datetime",
      "label": "Date",
      "required": false,
      "withTime": true
    },
    {
      "name": "draft",
      "type": "boolean",
      "label": "Draft",
      "required": false,
      "default": false
    },
    {
      "name": "tags",
      "type": "multiselect",
      "label": "Tags",
      "required": false,
      "options": [
        "foo",
        "bar"
      ],
      "allowCustom": true,
      "color": "blue"
    }
  ]
}
