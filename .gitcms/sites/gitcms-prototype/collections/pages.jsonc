{
  "label": "Pages",
  "description": "Top-level pages (content/_index.md).",
  "git_path": "/content/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Page Title",
      "required": true
    },
    {
      "name": "description",
      "type": "text",
      "label": "Page Description"
    },
    {
      "name": "params",
      "type": "group",
      "label": "Page",
      "fields": [
        {
          "name": "pageHeader",
          "type": "group",
          "label": "Page Header",
          "fields": [
            { "name": "enabled", "type": "boolean", "label": "Enabled", "default": true },
            { "name": "condensed", "type": "boolean", "label": "Condensed", "default": true },
            { "name": "heading", "type": "text", "label": "Heading" },
            { "name": "subheading", "type": "text", "label": "Subheading" },
            { "name": "image", "type": "image", "label": "Background Image" }
          ]
        },
        {
          "name": "components",
          "type": "list",
          "label": "Components",
          "description": "Pick a Type, then fill in only the fields that type uses (see each field's help text).",
          "itemLabel": "{type} {text}",
          "fields": [
            {
              "name": "type",
              "type": "select",
              "label": "Type",
              "required": true,
              "options": ["heading", "content", "accordion", "alert", "cards", "tabs"],
              "allowCustom": false
            },
            { "name": "level", "type": "number", "label": "Level", "description": "Heading only.", "integerOnly": true, "min": 2, "max": 6 },
            { "name": "text", "type": "text", "label": "Text", "description": "Heading only." },
            {
              "name": "variant",
              "type": "select",
              "label": "Variant",
              "description": "Alert only.",
              "options": ["default", "success", "warning", "error"],
              "allowCustom": false
            },
            { "name": "content", "type": "richtext", "label": "Content", "description": "Content and Alert." },
            { "name": "exclusive", "type": "boolean", "label": "Exclusive", "description": "Accordion only.", "default": true },
            {
              "name": "details",
              "type": "list",
              "label": "Details",
              "description": "Accordion only.",
              "itemLabel": "{summary}",
              "fields": [
                { "name": "summary", "type": "text", "label": "Summary" },
                { "name": "content", "type": "richtext", "label": "Content" },
                { "name": "open", "type": "boolean", "label": "Open", "default": false }
              ]
            },
            {
              "name": "cardlist",
              "type": "list",
              "label": "Card List",
              "description": "Cards only.",
              "itemLabel": "{heading}",
              "fields": [
                { "name": "heading", "type": "text", "label": "Heading" },
                { "name": "description", "type": "text", "label": "Description" },
                { "name": "content", "type": "richtext", "label": "Content" },
                {
                  "name": "footer",
                  "type": "list",
                  "label": "Footer Buttons",
                  "itemLabel": "{text}",
                  "fields": [
                    { "name": "text", "type": "text", "label": "Text" },
                    { "name": "url", "type": "text", "label": "URL" },
                    { "name": "style", "type": "select", "label": "Style", "options": ["default", "outline", "ghost"], "allowCustom": false },
                    { "name": "variant", "type": "select", "label": "Variant", "options": ["default", "primary", "secondary", "danger"], "allowCustom": false },
                    { "name": "size", "type": "select", "label": "Size", "options": ["default", "small", "large"], "allowCustom": false }
                  ]
                }
              ]
            },
            {
              "name": "tablist",
              "type": "list",
              "label": "Tab List",
              "description": "Tabs only.",
              "itemLabel": "{tab}",
              "fields": [
                { "name": "tab", "type": "text", "label": "Tab" },
                { "name": "tabpanel", "type": "richtext", "label": "Tab Panel" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
